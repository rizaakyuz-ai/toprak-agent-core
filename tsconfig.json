{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "baseUrl": "..",
    "paths": {
      "@/*": ["src/*"],
      "@toprak/*": ["toprak/*"]
    }
  },
  "include": ["**/*.ts", "**/*.json"],
  "exclude": ["storage", "node_modules"]
}
